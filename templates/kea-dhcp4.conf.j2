# {{ ansible_managed }}
{% import '_macros.j2' as m with context %}
{% set hooks = (m.db_hooks([kea_dhcp4_lease_database, kea_dhcp4_hosts_database]) | from_json)
             + (m.cmd_hooks() | from_json)
             + (m.legal_log_hook(kea_legal_log_base_name_v4) | from_json)
             + (m.ha_hook(kea_ha_dhcp4_port) | from_json)
             + kea_dhcp4_extra_hooks %}
{% set cfg = {
  "interfaces-config": {
    "interfaces": kea_dhcp4_interfaces,
    "dhcp-socket-type": kea_dhcp4_socket_type,
    "service-sockets-max-retries": kea_interfaces_service_sockets_max_retries | int,
    "service-sockets-retry-wait-time": kea_interfaces_service_sockets_retry_wait_time | int
  },
  "control-socket": {"socket-type": "unix", "socket-name": __kea_dhcp4_socket},
  "lease-database": kea_dhcp4_lease_database,
  "valid-lifetime": kea_dhcp4_valid_lifetime | int,
  "renew-timer": kea_dhcp4_renew_timer | int,
  "rebind-timer": kea_dhcp4_rebind_timer | int,
  "calculate-tee-times": kea_calculate_tee_times | bool,
  "authoritative": kea_dhcp4_authoritative | bool,
  "match-client-id": kea_dhcp4_match_client_id | bool,
  "cache-threshold": kea_cache_threshold | float,
  "parked-packet-limit": kea_parked_packet_limit | int,
  "early-global-reservations-lookup": kea_early_global_reservations_lookup | bool,
  "host-reservation-identifiers": kea_dhcp4_host_reservation_identifiers,
  "reservations-global": kea_reservations_global | bool,
  "reservations-in-subnet": kea_reservations_in_subnet | bool,
  "reservations-out-of-pool": kea_reservations_out_of_pool | bool,
  "multi-threading": m.multi_threading('dhcp4', kea_dhcp4_lease_database, kea_dhcp4_thread_pool_size, kea_dhcp4_packet_queue_size) | from_json,
  "option-def": kea_dhcp4_option_def,
  "option-data": kea_dhcp4_option_data,
  "client-classes": kea_dhcp4_client_classes + (m.pxe_v4_classes() | from_json),
  "reservations": kea_dhcp4_reservations,
  "subnet4": kea_dhcp4_subnets,
  "shared-networks": kea_dhcp4_shared_networks,
  "hooks-libraries": hooks,
  "loggers": m.loggers('kea-dhcp4', 'kea-dhcp4.log', kea_dhcp4_loggers, kea_dhcp4_extra_loggers) | from_json
} %}
{% if kea_dhcp4_hosts_database | length > 0 %}
{%   set cfg = cfg | combine({"hosts-database": kea_dhcp4_hosts_database}) %}
{% endif %}
{% set cfg = cfg | combine(m.ddns_globals() | from_json) | combine(kea_dhcp4_extra_config, recursive=true) %}
{{ {"Dhcp4": cfg} | to_nice_json(indent=2) }}
